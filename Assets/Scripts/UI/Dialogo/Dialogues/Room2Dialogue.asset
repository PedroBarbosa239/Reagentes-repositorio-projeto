  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65444957016785b43b037befd373c94e, type: 3}
  m_Name: Room2Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - characterName: Sarah
    text: OK isso foi estranho
  - characterName: Pedro
    text: "Esse lugar \xE9 completamente distorcido, parece um sonho"
  - characterName: Sarah
    text: ' Me parece mais um pesadelo'
  - characterName: ???
    text: "Olha s\xF3 gente nova"
  - characterName: Sarah
    text: "Quem \xE9 voc\xEA?"
  - characterName: ???
    text: "Isso pouco importa eu to preso aqui a meses, aquele cara me colocou aqui
      e s\xF3 sumiu"
  - characterName: Sarah
    text: " N\xF3s estamos atr\xE1s dele, mas acabamos ficando presos aqui, voc\xEA
      sabe como sair daqui?\r\n"
  - characterName: ???
    text: "Aquele psicopata quando me deixou aqui, disse que sair daqui para mim
      era imposs\xEDvel "
  - characterName: ???
    text: 'Que ele tinha deixado um monte de cubo estanho escondido e talvez isso
      ajudaria a sair '
  - characterName: Pedro
    text: "E voc\xEA sabe onde fica esses cubos?\r\n"
  - characterName: ???
    text: "Tem um aqui a onde eu estou, mas pouco adianta eu tocar eles, j\xE1 que
      eu n\xE3o sei onde esta os outros"
  - characterName: Sarah
    text: "A gente acha os cubos e todos sa\xEDmos daqui"
  - characterName: ???
    text: "N\xE3o"
  - characterName: Sarah
    text: "N\xE3o?"
  - characterName: Pedro
    text: O que?
  - characterName: ???
    text: "Eu n\xE3o quero sair daqui, sendo bem sincero esse espa\xE7o \xE9 bem
      confort\xE1vel"
  - characterName: ???
    text: " E agora que tem visita ficou bem melhor, bem melhor que l\xE1 fora\r\n"
  - characterName: Sarah
    text: "Voc\xEA est\xE1 maluco?"
  - characterName: Pedro
    text: "Eu n\xE3o tenho d\xFAvidas *cochicho*"
  - characterName: ???
    text: '*RiSAdas*'
  - characterName: ???
    text: Tentem o quanto quiserem, todos amam aqui
  - characterName: Sarah
    text: ...
  - characterName: Sarah
    text: Vamos Pedro, vamos dar um jeito de sair daqui
  - characterName: Pedro
    text: ...beleza
